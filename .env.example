# PostgreSQL (docker-compose local)
POSTGRES_DB=hermes
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes
POSTGRES_PORT=5432

# Backend - banco
DATABASE_URL=jdbc:postgresql://localhost:5432/hermes
DATABASE_USERNAME=hermes
DATABASE_PASSWORD=hermes
DB_POOL_NAME=HermesHikariPool
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

# Clerk - autenticacao (obrigatorio em producao)
# Dashboard -> seu app -> API Keys / Webhooks
AUTH_PROVIDER=clerk
CLERK_ISSUER_URI=https://<sua-instancia>.clerk.accounts.dev
CLERK_JWKS_URI=https://<sua-instancia>.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_<Signing Secret do endpoint /api/webhooks/clerk>

# Audiencias JWT aceitas pela API (separadas por virgula)
# Exemplo: JWT_ALLOWED_AUDIENCES=https://hermes-api,https://prepared-blowfish-68.clerk.accounts.dev
JWT_ALLOWED_AUDIENCES=

# Opcional: so se o backend chamar a API REST do Clerk (nao usado hoje)
# CLERK_SECRET_KEY=sk_test_<secret key>

# Dev local: permite webhook sem assinatura Svix (NUNCA use true em producao)
CLERK_WEBHOOK_REQUIRE_SIGNATURE=false
CLERK_WEBHOOK_MAX_TIMESTAMP_SKEW_SECONDS=300
CLERK_WEBHOOK_REPLAY_CACHE_TTL_SECONDS=900

# CORS - URL do frontend (Vite/Angular local)
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting para /api/public/** e /api/webhooks/**
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=DEBUG
