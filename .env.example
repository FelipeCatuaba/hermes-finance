# Docker compose - porta local do Postgres
POSTGRES_PORT=5432

# Backend - banco ao rodar com Maven local
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_HOST=localhost
SPRING_DATASOURCE_PORT=5432
SPRING_DATASOURCE_DB=hermes_local
SPRING_DATASOURCE_USERNAME=hermes
SPRING_DATASOURCE_PASSWORD=hermes_dev

# Backend - pool de conexao
DB_POOL_NAME=HermesHikariPool
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

# Auth interna JWT
# Use uma chave com pelo menos 32 caracteres e mantenha secreta em producao.
JWT_SECRET=dev-only-hermes-finance-secret-please-change
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_DAYS=30

# CORS - URL do frontend (Vite/Angular local)
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting para /api/public/** e /api/webhooks/**
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=DEBUG
