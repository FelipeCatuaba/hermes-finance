# PostgreSQL (docker-compose local)
POSTGRES_DB=hermes
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes
POSTGRES_PORT=5432

# Backend
DATABASE_URL=jdbc:postgresql://localhost:5432/hermes
DATABASE_USERNAME=hermes
DATABASE_PASSWORD=hermes
DB_POOL_NAME=HermesHikariPool
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
JWT_SECRET=replace-with-256-bit-random-string
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
ARGON2_PEPPER=replace-with-long-random-pepper
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=DEBUG
