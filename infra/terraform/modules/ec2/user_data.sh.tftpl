#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker jq
systemctl enable docker
systemctl start docker
usermod -aG docker ec2-user

mkdir -p /opt/hermes
cat >/opt/hermes/deploy.sh <<'SCRIPT'
#!/bin/bash
set -euo pipefail

AWS_REGION="${aws_region}"
ECR_REPOSITORY_URL="${ecr_repository_url}"
SSM_PREFIX="${ssm_parameter_prefix}"
APP_PORT="${app_port}"
IMAGE_TAG="$${1:-latest}"

fetch_param() {
  aws ssm get-parameter --region "$AWS_REGION" --name "$1" --with-decryption --query 'Parameter.Value' --output text
}

DB_HOST=$(fetch_param "$${SSM_PREFIX}SPRING_DATASOURCE_HOST")
DB_NAME=$(fetch_param "$${SSM_PREFIX}SPRING_DATASOURCE_DB")
DB_USER=$(fetch_param "$${SSM_PREFIX}SPRING_DATASOURCE_USERNAME")
DB_PASS=$(fetch_param "$${SSM_PREFIX}SPRING_DATASOURCE_PASSWORD")
CLERK_ISSUER_URI=$(fetch_param "$${SSM_PREFIX}CLERK_ISSUER_URI")
CLERK_JWKS_URI=$(fetch_param "$${SSM_PREFIX}CLERK_JWKS_URI")
CLERK_WEBHOOK_SECRET=$(fetch_param "$${SSM_PREFIX}CLERK_WEBHOOK_SECRET")
CLERK_WEBHOOK_REQUIRE_SIGNATURE=$(fetch_param "$${SSM_PREFIX}CLERK_WEBHOOK_REQUIRE_SIGNATURE")
CLERK_WEBHOOK_MAX_TIMESTAMP_SKEW_SECONDS=$(fetch_param "$${SSM_PREFIX}CLERK_WEBHOOK_MAX_TIMESTAMP_SKEW_SECONDS")
CLERK_WEBHOOK_REPLAY_CACHE_TTL_SECONDS=$(fetch_param "$${SSM_PREFIX}CLERK_WEBHOOK_REPLAY_CACHE_TTL_SECONDS")
AUTH_PROVIDER=$(fetch_param "$${SSM_PREFIX}AUTH_PROVIDER")
ALLOWED_ORIGINS=$(fetch_param "$${SSM_PREFIX}ALLOWED_ORIGINS")
JWT_ALLOWED_AUDIENCES=$(fetch_param "$${SSM_PREFIX}JWT_ALLOWED_AUDIENCES")
RATE_LIMIT_MAX_REQUESTS=$(fetch_param "$${SSM_PREFIX}RATE_LIMIT_MAX_REQUESTS")
RATE_LIMIT_WINDOW_SECONDS=$(fetch_param "$${SSM_PREFIX}RATE_LIMIT_WINDOW_SECONDS")
DB_POOL_NAME=$(fetch_param "$${SSM_PREFIX}DB_POOL_NAME")
DB_MAX_POOL_SIZE=$(fetch_param "$${SSM_PREFIX}DB_MAX_POOL_SIZE")
DB_MIN_IDLE=$(fetch_param "$${SSM_PREFIX}DB_MIN_IDLE")
DB_CONNECTION_TIMEOUT_MS=$(fetch_param "$${SSM_PREFIX}DB_CONNECTION_TIMEOUT_MS")
DB_IDLE_TIMEOUT_MS=$(fetch_param "$${SSM_PREFIX}DB_IDLE_TIMEOUT_MS")
DB_MAX_LIFETIME_MS=$(fetch_param "$${SSM_PREFIX}DB_MAX_LIFETIME_MS")
LOG_LEVEL=$(fetch_param "$${SSM_PREFIX}LOG_LEVEL")

aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$${ECR_REPOSITORY_URL%/*}"

docker pull "$ECR_REPOSITORY_URL:$IMAGE_TAG"

docker rm -f hermes-finance || true

docker run -d --name hermes-finance --restart always -p "$APP_PORT:8080" \
  -e SPRING_PROFILES_ACTIVE=prd \
  -e SPRING_DATASOURCE_URL="jdbc:postgresql://$DB_HOST:5432/$DB_NAME" \
  -e SPRING_DATASOURCE_USERNAME="$DB_USER" \
  -e SPRING_DATASOURCE_PASSWORD="$DB_PASS" \
  -e CLERK_ISSUER_URI="$CLERK_ISSUER_URI" \
  -e CLERK_JWKS_URI="$CLERK_JWKS_URI" \
  -e CLERK_WEBHOOK_SECRET="$CLERK_WEBHOOK_SECRET" \
  -e CLERK_WEBHOOK_REQUIRE_SIGNATURE="$CLERK_WEBHOOK_REQUIRE_SIGNATURE" \
  -e CLERK_WEBHOOK_MAX_TIMESTAMP_SKEW_SECONDS="$CLERK_WEBHOOK_MAX_TIMESTAMP_SKEW_SECONDS" \
  -e CLERK_WEBHOOK_REPLAY_CACHE_TTL_SECONDS="$CLERK_WEBHOOK_REPLAY_CACHE_TTL_SECONDS" \
  -e AUTH_PROVIDER="$AUTH_PROVIDER" \
  -e ALLOWED_ORIGINS="$ALLOWED_ORIGINS" \
  -e JWT_ALLOWED_AUDIENCES="$JWT_ALLOWED_AUDIENCES" \
  -e RATE_LIMIT_MAX_REQUESTS="$RATE_LIMIT_MAX_REQUESTS" \
  -e RATE_LIMIT_WINDOW_SECONDS="$RATE_LIMIT_WINDOW_SECONDS" \
  -e DB_POOL_NAME="$DB_POOL_NAME" \
  -e DB_MAX_POOL_SIZE="$DB_MAX_POOL_SIZE" \
  -e DB_MIN_IDLE="$DB_MIN_IDLE" \
  -e DB_CONNECTION_TIMEOUT_MS="$DB_CONNECTION_TIMEOUT_MS" \
  -e DB_IDLE_TIMEOUT_MS="$DB_IDLE_TIMEOUT_MS" \
  -e DB_MAX_LIFETIME_MS="$DB_MAX_LIFETIME_MS" \
  -e LOG_LEVEL="$LOG_LEVEL" \
  "$ECR_REPOSITORY_URL:$IMAGE_TAG"
SCRIPT

chmod +x /opt/hermes/deploy.sh
