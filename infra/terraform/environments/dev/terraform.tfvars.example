aws_region      = "us-east-1"
project_name    = "hermes-finance"
environment     = "dev"
owner           = "felipe"
cost_center     = "learning"

allowed_ssh_cidrs = ["YOUR_PUBLIC_IP/32"]

# RDS

db_username = "hermes"
db_password = "CHANGE_ME"

# GitHub OIDC

github_owner = "YOUR_GITHUB_USER_OR_ORG"
github_repo  = "hermes-finance"

existing_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

plain_ssm_parameters = {
  "/hermes/dev/AUTH_PROVIDER"                     = "clerk"
  "/hermes/dev/CLERK_ISSUER_URI"                  = "https://your-instance.clerk.accounts.dev"
  "/hermes/dev/CLERK_JWKS_URI"                    = "https://your-instance.clerk.accounts.dev/.well-known/jwks.json"
  "/hermes/dev/CLERK_WEBHOOK_REQUIRE_SIGNATURE"   = "true"
  "/hermes/dev/CLERK_WEBHOOK_MAX_TIMESTAMP_SKEW_SECONDS" = "300"
  "/hermes/dev/CLERK_WEBHOOK_REPLAY_CACHE_TTL_SECONDS"   = "900"
  "/hermes/dev/ALLOWED_ORIGINS"                   = "https://your-frontend.example"
  "/hermes/dev/JWT_ALLOWED_AUDIENCES"             = ""
  "/hermes/dev/RATE_LIMIT_MAX_REQUESTS"           = "120"
  "/hermes/dev/RATE_LIMIT_WINDOW_SECONDS"         = "60"
  "/hermes/dev/DB_POOL_NAME"                      = "HermesHikariPool"
  "/hermes/dev/DB_MAX_POOL_SIZE"                  = "10"
  "/hermes/dev/DB_MIN_IDLE"                       = "2"
  "/hermes/dev/DB_CONNECTION_TIMEOUT_MS"          = "30000"
  "/hermes/dev/DB_IDLE_TIMEOUT_MS"                = "600000"
  "/hermes/dev/DB_MAX_LIFETIME_MS"                = "1800000"
  "/hermes/dev/LOG_LEVEL"                         = "INFO"
}

secure_ssm_parameters = {
  "/hermes/dev/CLERK_WEBHOOK_SECRET" = "whsec_change_me"
}
